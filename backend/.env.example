# Backend Secrets
PORT=8090
BACKEND_URL=http://localhost:8090
DOCKER_BACKEND_URL=http://backend:8090
FRONTEND_URL=http://localhost:3000

# Database Configs (pgvector)
DB_POSTGRES_TYPE=postgres
DB_POSTGRES_HOST=database
DB_POSTGRES_PORT=5432
DB_POSTGRES_USERNAME=postgres
DB_POSTGRES_PASSWORD=123
DB_POSTGRES_DATABASE=rag_db
DB_POSTGRES_LOGGING=false
DB_RETRY_ATTEMPTS=10
DB_RETRY_DELAY=5000

# Docker User
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_DB=rag_db

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# Cloudinary Credentials (for PDF storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=RAG_POC

# Google Gemini API Key
GEMINI_API_KEY=
